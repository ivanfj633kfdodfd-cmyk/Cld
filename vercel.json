{
  "version": 2,
  "builds": [
    {
      "src": "bot.py",
      "use": "@vercel/python"
    },
    {
      "src": "webapp/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/webhook",
      "dest": "bot.py"
    },
    {
      "src": "/webapp/(.*)",
      "dest": "webapp/$1"
    },
    {
      "src": "/webapp",
      "dest": "webapp/index.html"
    },
    {
      "src": "/",
      "dest": "bot.py"
    }
  ]
}
